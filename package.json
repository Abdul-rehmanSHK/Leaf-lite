{
  "name": "leaflite-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"magenta,cyan\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev",
    "dev:backend": "npm run backend",
    "dev:frontend": "npm run frontend",
    "frontend": "powershell -Command \"Set-Location frontend; npm run dev\"",
    "backend": "powershell -Command \"Set-Location backend; python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
